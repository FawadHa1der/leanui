// The LeanUI site on Cloudflare: a Worker in front of one container running `leanui-site`
// (examples/SiteServer.lean, built for linux/amd64). See docs/DEPLOY.md.
{
  "name": "leanui-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Served at leanui-site.<subdomain>.workers.dev; no extra preview URL per uploaded version.
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "SiteServer",
      "image": "./Dockerfile",
      // One instance: server-driven sessions (the Safari path) live in its memory.
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SITE", "class_name": "SiteServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteServer"] }]
}
